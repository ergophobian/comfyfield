{
  "1": {
    "class_type": "LoadAudio",
    "inputs": {
      "audio": "{{audio}}"
    },
    "_meta": {
      "title": "Recording"
    }
  },
  "2": {
    "class_type": "TrimAudioDuration",
    "inputs": {
      "audio": [
        "1",
        0
      ],
      "start_index": 0.0,
      "duration": 27.0
    }
  },
  "3": {
    "class_type": "LoadAudio",
    "inputs": {
      "audio": "{{voice}}"
    },
    "_meta": {
      "title": "New voice"
    }
  },
  "4": {
    "class_type": "FL_ChatterboxVC",
    "inputs": {
      "input_audio": [
        "2",
        0
      ],
      "target_voice": [
        "3",
        0
      ],
      "seed": "{{seed}}",
      "use_cpu": false,
      "keep_model_loaded": false
    }
  },
  "5": {
    "class_type": "SaveAudioAdvanced",
    "inputs": {
      "audio": [
        "4",
        0
      ],
      "filename_prefix": "comfyfield/chatterbox_vc",
      "format": "flac"
    }
  }
}
