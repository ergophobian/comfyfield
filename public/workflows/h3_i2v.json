{
  "1": { "class_type": "LoadImage", "inputs": { "image": "{{image}}" } },
  "2": {
    "class_type": "MinimaxHailuo03FirstLastFrameNode",
    "inputs": {
      "model": "MiniMax H3",
      "model.prompt": "{{prompt}}",
      "model.resolution": "768P",
      "model.duration": "{{duration}}",
      "first_frame": ["1", 0],
      "seed": "{{seed}}",
      "watermark": false
    }
  },
  "3": { "class_type": "SaveVideo", "inputs": { "video": ["2", 0], "filename_prefix": "comfyfield/h3", "format": "mp4", "codec": "h264", "format.codec": "h264" } }
}
