      "temporal_overlap": 1,
      "chunking_mode": "auto"
    }
  },
  "13": {
    "class_type": "SeedVR2Conditioning",
    "inputs": {
      "model": [
        "8",
        0
      ],
      "vae_conditioning": [
        "12",
        0
      ]
    }
  },
  "14": {
    "class_type": "KSampler",
    "inputs": {
      "model": [
        "8",
        0
      ],
      "seed": "{{seed}}",
      "steps": 1,
      "cfg": 1,
      "sampler_name": "euler",
      "scheduler": "simple",
      "positive": [
        "13",
        0
      ],
      "negative": [
        "13",
        1
      ],
      "latent_image": [
        "12",
        0
      ],
      "denoise": 1
    }
  },
  "15": {
    "class_type": "SeedVR2TemporalMerge",
    "inputs": {
      "latents": [
        "14",
        0
      ],
      "temporal_overlap": [
        "12",
        1
      ]
    }
  },
  "16": {
    "class_type": "VAEDecodeTiled",
    "inputs": {
      "samples": [
        "15",
        0
      ],
      "vae": [
        "9",
        0
      ],
      "tile_size": 512,
      "overlap": 128,
      "temporal_size": 64,
      "temporal_overlap": 8
    }
  },
  "17": {
    "class_type": "SeedVR2PostProcessing",
    "inputs": {
      "images": [
        "16",
        0
      ],
      "original_resized_images": [
        "7",
        0
      ],
