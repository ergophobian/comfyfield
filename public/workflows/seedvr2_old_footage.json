      "title": "Merge the two fields"
    }
  },
  "22": {
    "class_type": "ImageScale",
    "inputs": {
      "image": [
        "21",
        0
      ],
      "upscale_method": "bicubic",
      "width": [
        "4",
        0
      ],
      "height": [
        "4",
        1
      ],
      "crop": "disabled"
    }
  },
  "23": {
    "class_type": "ImageBlend",
    "inputs": {
      "image1": [
        "3",
        0
      ],
      "image2": [
        "22",
        0
      ],
      "blend_factor": "{{deinterlace}}",
      "blend_mode": "normal"
    },
    "_meta": {
      "title": "Deinterlace"
    }
  },
  "24": {
    "class_type": "ImageBlur",
    "inputs": {
      "image": [
        "23",
        0
      ],
      "blur_radius": 2,
      "sigma": 1
    }
  },
  "25": {
    "class_type": "ImageBlend",
    "inputs": {
      "image1": [
        "23",
        0
      ],
      "image2": [
        "24",
        0
      ],
      "blend_factor": "{{denoise}}",
      "blend_mode": "normal"
    },
    "_meta": {
      "title": "Denoise"
    }
  }
