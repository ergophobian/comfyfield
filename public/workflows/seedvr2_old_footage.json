    "inputs": {
      "resized_images": [
        "7",
        0
      ]
    }
  },
  "11": {
    "class_type": "VAEEncodeTiled",
    "inputs": {
      "pixels": [
        "10",
        0
      ],
      "vae": [
        "9",
        0
      ],
      "tile_size": 512,
      "overlap": 128,
      "temporal_size": 64,
      "temporal_overlap": 8
    }
  },
  "12": {
    "class_type": "SeedVR2TemporalChunk",
