    "inputs": {
      "video": [
        "18",
        0
      ],
      "filename_prefix": "comfyfield/seedvr2_old_footage",
      "format": "mp4",
      "codec": "h264",
      "format.codec": "h264"
    }
  },
  "20": {
    "class_type": "ComfyMathExpression",
    "inputs": {
      "expression": "max(2, b // 2)",
      "values.b": [
        "4",
        1
      ]
    }
  },
  "21": {
    "class_type": "ImageScale",
    "inputs": {
      "image": [
        "3",
        0
      ],
      "upscale_method": "area",
      "width": [
        "4",
        0
      ],
      "height": [
        "20",
        1
      ],
      "crop": "disabled"
