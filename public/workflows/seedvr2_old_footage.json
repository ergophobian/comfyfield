{
  "1": {
    "class_type": "LoadVideo",
    "inputs": {
      "file": "{{video}}"
    }
  },
  "2": {
    "class_type": "Video Slice",
    "inputs": {
      "video": [
        "1",
        0
      ],
      "start_time": "{{start}}",
      "duration": "{{duration}}",
      "strict_duration": false
    }
  },
  "3": {
    "class_type": "GetVideoComponents",
    "inputs": {
      "video": [
        "2",
        0
      ]
    }
  },
  "4": {
    "class_type": "GetImageSize",
    "inputs": {
      "image": [
        "3",
        0
      ]
    }
  },
  "5": {
    "class_type": "PrimitiveFloat",
    "inputs": {
      "value": "{{upscale_factor}}"
    }
  },
  "6": {
    "class_type": "ComfyMathExpression",
    "inputs": {
      "expression": "max(1, min(c, 3840 / max(a, b)))",
      "values.a": [
        "4",
        0
      ],
      "values.b": [
        "4",
        1
      ],
      "values.c": [
        "5",
        0
      ]
    }
  },
  "7": {
    "class_type": "ResizeImageMaskNode",
    "inputs": {
      "input": [
        "25",
        0
