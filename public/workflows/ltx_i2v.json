{
  "1": { "class_type": "CheckpointLoaderSimple", "inputs": { "ckpt_name": "ltx-video-2b-v0.9.5.safetensors" } },
  "2": { "class_type": "CLIPLoader", "inputs": { "clip_name": "t5xxl_fp16.safetensors", "type": "ltxv" } },
  "3": { "class_type": "CLIPTextEncode", "inputs": { "text": "{{prompt}}", "clip": ["2", 0] } },
  "4": { "class_type": "CLIPTextEncode", "inputs": { "text": "low quality, worst quality, deformed, distorted, watermark", "clip": ["2", 0] } },
  "5": { "class_type": "LTXVConditioning", "inputs": { "frame_rate": 24, "positive": ["3", 0], "negative": ["4", 0] } },
  "6": { "class_type": "LTXVImgToVideo", "inputs": { "positive": ["5", 0], "negative": ["5", 1], "vae": ["1", 2], "image": ["12", 0], "width": "{{width}}", "height": "{{height}}", "length": "{{frames}}", "batch_size": 1, "strength": 1 } },
  "7": { "class_type": "LTXVScheduler", "inputs": { "steps": 30, "max_shift": 2.05, "base_shift": 0.95, "stretch": true, "terminal": 0.1, "latent": ["6", 2] } },
  "8": { "class_type": "KSamplerSelect", "inputs": { "sampler_name": "euler" } },
  "9": { "class_type": "SamplerCustom", "inputs": { "add_noise": true, "noise_seed": "{{seed}}", "cfg": 3, "model": ["1", 0], "positive": ["6", 0], "negative": ["6", 1], "sampler": ["8", 0], "sigmas": ["7", 0], "latent_image": ["6", 2] } },
  "10": { "class_type": "VAEDecode", "inputs": { "samples": ["9", 0], "vae": ["1", 2] } },
  "11": { "class_type": "SaveVideo", "inputs": { "video": ["13", 0], "filename_prefix": "comfyfield/ltx", "format": "mp4", "codec": "h264", "format.codec": "h264" } },
  "12": { "class_type": "LoadImage", "inputs": { "image": "{{image}}" } },
  "13": { "class_type": "CreateVideo", "inputs": { "images": ["10", 0], "fps": 24 } }
}
