{
  "1": {
    "class_type": "UNETLoader",
    "inputs": {
      "unet_name": "fasth3_omniref_8step_pruned_int8_convrot.safetensors",
      "weight_dtype": "default"
    }
  },
  "2": {
    "class_type": "MiniMaxH3SigmaShift",
    "inputs": {
      "model": [
        "1",
        0
      ],
      "shift_video": 12,
      "shift_audio": 3
    }
  },
  "3": {
    "class_type": "CLIPLoader",
    "inputs": {
      "clip_name": "qwen3vl_32b_minimax_h3_nvfp4_awq.safetensors",
      "type": "minimax",
      "device": "default"
    }
  },
  "4": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "minimax_h3_video_vae_fp16.safetensors"
    }
  },
  "5": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "minimax_h3_audio_vae_fp32.safetensors"
    }
  },
  "6": {
    "class_type": "MiniMaxH3ReferenceToVideo",
    "inputs": {
      "clip": [
        "3",
        0
      ],
      "vae": [
        "4",
        0
      ],
      "audio_vae": [
        "5",
        0
      ],
      "prompt": "{{prompt}}",
      "width": "{{width}}",
      "height": "{{height}}",
      "length": [
        "21",
        1
      ],
      "ref_image_size": "match",
      "ref_images.ref_image_0": [
        "30",
        0
      ],
      "ref_images.ref_image_1": [
        "31",
        0
      ],
      "ref_images.ref_image_2": [
        "32",
        0
      ],
      "ref_audios.ref_audio_0": [
        "52",
        0
      ]
    }
  },
  "7": {
    "class_type": "RandomNoise",
    "inputs": {
      "noise_seed": "{{seed}}"
    }
  },
  "8": {
    "class_type": "KSamplerSelect",
    "inputs": {
      "sampler_name": "euler"
    }
  },
  "9": {
    "class_type": "BasicScheduler",
    "inputs": {
      "model": [
        "17",
        0
      ],
      "scheduler": "simple",
      "steps": 8,
      "denoise": 1
    }
  },
  "10": {
    "class_type": "BasicGuider",
    "inputs": {
      "model": [
        "17",
        0
      ],
      "conditioning": [
        "6",
        0
      ]
    }
  },
  "11": {
    "class_type": "SamplerCustomAdvanced",
    "inputs": {
      "noise": [
        "7",
        0
      ],
      "guider": [
        "10",
        0
      ],
      "sampler": [
        "8",
        0
      ],
      "sigmas": [
        "9",
        0
      ],
      "latent_image": [
        "6",
        1
      ]
    }
  },
  "12": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": [
        "11",
        0
      ],
      "vae": [
        "4",
        0
      ]
    }
  },
  "13": {
    "class_type": "VAEDecodeAudio",
    "inputs": {
      "samples": [
        "11",
        0
      ],
      "vae": [
        "5",
        0
      ]
    }
  },
  "14": {
    "class_type": "CreateVideo",
    "inputs": {
      "images": [
        "12",
        0
      ],
      "audio": [
        "13",
        0
      ],
      "fps": 24
    }
  },
  "15": {
    "class_type": "SaveVideo",
    "inputs": {
      "video": [
        "14",
        0
      ],
      "filename_prefix": "comfyfield/influencer_video",
      "format": "mp4",
      "codec": "h264",
      "format.codec": "h264"
    }
  },
  "17": {
    "class_type": "BlockSparseAttention",
    "_meta": {
      "title": "FastH3 is trained with VSA, so it must not run plain block-sparse attention"
    },
    "inputs": {
      "model": [
        "2",
        0
      ],
      "selection": "vsa",
      "selection.keep_percent": 10,
      "start_percent": 0,
      "end_percent": 1,
      "dense_blocks": "",
      "min_tokens": 12288,
      "extra_tokens": 256,
      "sink_conditioning": "exact_kv_and_rows",
      "verbose": false
    }
  },
  "20": {
    "class_type": "PrimitiveFloat",
    "_meta": {
      "title": "Output length"
    },
    "inputs": {
      "value": "{{seconds}}"
    }
  },
  "21": {
    "class_type": "ComfyMathExpression",
    "inputs": {
      "expression": "max(5, round(a * 24)) + (5 - (max(5, round(a * 24)) % 17)) % 17",
      "values.a": [
        "20",
        0
      ]
    }
  },
  "30": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "{{image}}"
    },
    "_meta": {
      "title": "Character, picture 1"
    }
  },
  "31": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "{{image2}}"
    },
    "_meta": {
      "title": "Character, picture 2",
      "optional": "image2"
    }
  },
  "32": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "{{image3}}"
    },
    "_meta": {
      "title": "Character, picture 3",
      "optional": "image3"
    }
  },
  "40": {
    "class_type": "LoadAudio",
    "inputs": {
      "audio": "{{voice}}"
    },
    "_meta": {
      "title": "Saved voice",
      "optional": "voice"
    }
  },
  "51": {
    "class_type": "FL_ChatterboxMultilingualTTS",
    "inputs": {
      "text": "{{script}}",
      "language": "{{language}}",
      "exaggeration": "{{exaggeration}}",
      "cfg_weight": "{{cfg_weight}}",
      "temperature": 0.8,
      "repetition_penalty": 2,
      "min_p": 0.05,
      "top_p": 1,
      "seed": "{{seed}}",
      "use_cpu": false,
      "keep_model_loaded": false,
      "audio_prompt": [
        "40",
        0
      ]
    },
    "_meta": {
      "title": "Speech"
    }
  },
  "52": {
    "class_type": "TrimAudioDuration",
    "inputs": {
      "audio": [
        "51",
        0
      ],
      "start_index": 0,
      "duration": [
        "20",
        0
      ]
    },
    "_meta": {
      "title": "Speech, cut to the length"
    }
  }
}
