{
  "1": {
    "class_type": "LoadVideo",
    "inputs": {
      "file": "{{video}}"
    }
  },
  "2": {
    "class_type": "ComfyMathExpression",
    "inputs": {
      "expression": "min(a, 15)",
      "values.a": "{{duration}}"
    }
  },
  "3": {
    "class_type": "Video Slice",
    "inputs": {
      "video": [
        "1",
        0
      ],
      "start_time": "{{start}}",
      "duration": [
        "2",
        0
      ],
      "strict_duration": false
    }
  },
  "4": {
    "class_type": "GetVideoComponents",
    "inputs": {
      "video": [
        "3",
        0
      ]
    }
  },
  "5": {
    "class_type": "HunyuanFoleyModelLoader",
    "inputs": {
      "model_path_name": "hunyuan_foley",
      "foley_checkpoint_name": "hunyuanvideo_foley.pth"
    }
  },
  "6": {
    "class_type": "LoadDACHunyuanVAE",
    "inputs": {
      "vae_name": "vae_128d_48k.pth"
    }
  },
  "7": {
    "class_type": "HunyuanFoleySampler",
    "inputs": {
      "foley_model": [
        "5",
        0
      ],
      "video_frames": [
        "4",
        0
      ],
      "fps": [
        "4",
        2
      ],
      "prompt": "{{prompt}}",
      "negative_prompt": "noisy, harsh",
      "guidance_scale": 4.5,
      "steps": 50,
      "seed": "{{seed}}"
    }
  },
  "8": {
    "class_type": "DACHunyuanVAEDecode",
    "inputs": {
      "samples": [
        "7",
        0
      ],
      "vae": [
        "6",
        0
      ],
      "unload_models_after_use": true
    }
  },
  "9": {
    "class_type": "CreateVideo",
    "inputs": {
      "images": [
        "4",
        0
      ],
      "audio": [
        "8",
        0
      ],
      "fps": [
        "4",
        2
      ]
    }
  },
  "10": {
    "class_type": "SaveVideo",
    "inputs": {
      "video": [
        "9",
        0
      ],
      "filename_prefix": "comfyfield/hunyuan_foley",
      "format": "mp4",
      "codec": "h264",
      "format.codec": "h264"
    }
  }
}
