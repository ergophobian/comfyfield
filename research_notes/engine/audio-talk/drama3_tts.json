{
  "1": {
    "class_type": "Drama3Loader",
    "inputs": {
      "model_name": "drama3_fp8experts_bf16.safetensors",
      "experts": "in RAM",
      "expert_cache_gb": 0.0,
      "second_gpu": "none",
      "split_layer": 0
    }
  },
  "2": {
    "class_type": "Drama3CodecLoader",
    "inputs": {
      "codec_name": "drama3_codec.safetensors"
    }
  },
  "3": {
    "class_type": "LoadAudio",
    "inputs": {
      "audio": "{{voice}}"
    },
    "_meta": {
      "title": "Saved voice",
      "optional": "voice"
    }
  },
  "4": {
    "class_type": "Qwen3ASRLoader",
    "inputs": {
      "model_name": "qwen3_asr_0.6b_bf16.safetensors"
    },
    "_meta": {
      "title": "Transcribe the voice",
      "optional": "voice"
    }
  },
  "5": {
    "class_type": "Qwen3ASRTranscribe",
    "inputs": {
      "model": [
        "4",
        0
      ],
      "audio": [
        "3",
        0
      ],
      "language": "auto",
      "context": "",
      "max_new_tokens": 4096
    },
    "_meta": {
      "title": "Voice transcript",
      "optional": "voice"
    }
  },
  "6": {
    "class_type": "Drama3EncodeVoice",
    "inputs": {
      "codec": [
        "2",
        0
      ],
      "audio": [
        "3",
        0
      ],
      "transcript": [
        "5",
        0
      ]
    },
    "_meta": {
      "title": "Encode the voice",
      "optional": "voice"
    }
  },
  "7": {
    "class_type": "Drama3Generate",
    "inputs": {
      "model": [
        "1",
        0
      ],
      "text": "{{prompt}}",
      "voices.voice0": [
        "6",
        0
      ],
      "seed": "{{seed}}",
      "temperature": 1.0,
      "top_p": 0.9,
      "top_k": 0,
      "max_frames": 600,
      "split_long_text": true,
      "speakers": "one take per line"
    }
  },
  "8": {
    "class_type": "Drama3Decode",
    "inputs": {
      "codec": [
        "2",
        0
      ],
      "codes": [
        "7",
        0
      ],
      "shorten_long_pauses": true
    }
  },
  "9": {
    "class_type": "SaveAudioAdvanced",
    "inputs": {
      "audio": [
        "8",
        0
      ],
      "filename_prefix": "comfyfield/drama3_tts",
      "format": "flac"
    }
  }
}
