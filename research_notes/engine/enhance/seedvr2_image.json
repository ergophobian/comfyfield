  },
  "9": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "seedvr2_ema_vae_fp16.safetensors"
    }
  },
  "10": {
    "class_type": "SeedVR2Preprocess",
    "inputs": {
      "resized_images": [
        "7",
        0
      ]
    }
  },
  "11": {
    "class_type": "VAEEncodeTiled",
    "inputs": {
      "pixels": [
        "10",
        0
      ],
      "vae": [
        "9",
        0
      ],
      "tile_size": 512,
      "overlap": 128,
      "temporal_size": 4096,
      "temporal_overlap": 8
    }
  },
  "12": {
    "class_type": "SeedVR2Conditioning",
    "inputs": {
      "model": [
        "8",
        0
      ],
      "vae_conditioning": [
        "11",
        0
      ]
    }
  },
  "13": {
    "class_type": "KSampler",
    "inputs": {
      "model": [
        "8",
        0
      ],
      "seed": "{{seed}}",
      "steps": 1,
      "cfg": 1,
      "sampler_name": "euler",
      "scheduler": "simple",
      "positive": [
        "12",
        0
      ],
      "negative": [
        "12",
        1
      ],
      "latent_image": [
        "11",
        0
      ],
      "denoise": 1
    }
