      "resize_type.longer_size": [
        "6",
        1
      ],
      "scale_method": "lanczos"
    }
  },
  "8": {
    "class_type": "UNETLoader",
    "inputs": {
      "unet_name": "seedvr2_3b_int8_convrot.safetensors",
      "weight_dtype": "default"
