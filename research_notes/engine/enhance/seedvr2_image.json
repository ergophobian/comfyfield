{
  "1": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "{{image}}"
    }
  },
  "2": {
    "class_type": "JoinImageWithAlpha",
    "inputs": {
      "image": [
        "1",
        0
      ],
      "alpha": [
        "1",
        1
      ]
    }
  },
  "3": {
    "class_type": "GetImageSize",
    "inputs": {
      "image": [
        "1",
        0
      ]
    }
  },
  "4": {
    "class_type": "PrimitiveFloat",
    "inputs": {
      "value": "{{upscale_factor}}"
    }
  },
  "5": {
    "class_type": "PrimitiveInt",
    "inputs": {
      "value": "{{target}}"
    }
  },
  "6": {
    "class_type": "ComfyMathExpression",
    "inputs": {
      "expression": "max(16, c if c > 0 else round(max(a, b) * d))",
      "values.a": [
        "3",
        0
      ],
      "values.b": [
        "3",
        1
      ],
      "values.c": [
        "5",
        0
      ],
      "values.d": [
        "4",
        0
      ]
    }
  },
  "7": {
