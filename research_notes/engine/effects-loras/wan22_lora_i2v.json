        "2",
        0
      ],
      "values.b": [
        "2",
        1
      ]
    },
    "_meta": {
      "title": "Width: the photo's shape at about 832 x 480 pixels"
    }
  },
  "4": {
    "class_type": "ComfyMathExpression",
    "inputs": {
      "expression": "max(16, 16 * round(b * sqrt(399360 / (a * b)) / 16))",
