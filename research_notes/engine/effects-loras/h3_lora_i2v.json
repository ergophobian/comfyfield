{
  "1": {
    "class_type": "UNETLoader",
    "inputs": {
      "unet_name": "minimax_h3_fl2va_pruned_int8_convrot.safetensors",
      "weight_dtype": "default"
    }
  },
  "2": {
    "class_type": "LoraLoaderModelOnly",
    "inputs": {
      "model": [
        "1",
        0
      ],
      "lora_name": "{{lora}}",
      "strength_model": "{{lora_strength}}"
    },
    "_meta": {
      "title": "Effect LoRA"
    }
  },
  "3": {
    "class_type": "CLIPLoader",
    "inputs": {
      "clip_name": "qwen3vl_32b_minimax_h3_nvfp4_awq.safetensors",
      "type": "minimax",
      "device": "default"
    }
  },
  "4": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "minimax_h3_video_vae_fp16.safetensors"
    }
  },
  "5": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "minimax_h3_audio_vae_fp32.safetensors"
    }
  },
  "6": {
    "class_type": "MiniMaxH3ImageToVideo",
    "inputs": {
      "clip": [
        "3",
        0
      ],
      "vae": [
        "4",
        0
      ],
      "prompt": "{{prompt}}",
      "width": [
        "18",
        1
      ],
      "height": [
        "19",
        1
      ],
      "length": "{{frames}}",
      "first_frame": [
        "16",
        0
      ],
      "last_frame": [
        "20",
        0
      ]
    }
  },
  "7": {
    "class_type": "RandomNoise",
    "inputs": {
      "noise_seed": "{{seed}}"
    }
  },
  "8": {
    "class_type": "KSamplerSelect",
    "inputs": {
      "sampler_name": "res_multistep"
    }
  },
  "9": {
    "class_type": "BasicScheduler",
    "inputs": {
      "model": [
        "2",
        0
      ],
      "scheduler": "simple",
      "steps": 20,
      "denoise": 1.0
    }
  },
  "10": {
    "class_type": "BasicGuider",
    "inputs": {
      "model": [
        "2",
        0
      ],
      "conditioning": [
        "6",
        0
      ]
    }
  },
  "11": {
    "class_type": "SamplerCustomAdvanced",
    "inputs": {
      "noise": [
        "7",
        0
      ],
      "guider": [
        "10",
        0
      ],
      "sampler": [
        "8",
        0
      ],
      "sigmas": [
        "9",
        0
      ],
      "latent_image": [
        "6",
        1
      ]
    }
  },
  "12": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": [
        "11",
        0
      ],
      "vae": [
        "4",
        0
      ]
    }
  },
  "13": {
    "class_type": "VAEDecodeAudio",
    "inputs": {
      "samples": [
        "11",
        0
      ],
      "vae": [
        "5",
        0
      ]
    }
  },
  "14": {
    "class_type": "CreateVideo",
    "inputs": {
      "images": [
        "12",
        0
      ],
      "audio": [
        "13",
        0
      ],
      "fps": 24
    }
  },
  "15": {
    "class_type": "SaveVideo",
    "inputs": {
      "video": [
        "14",
        0
      ],
      "filename_prefix": "comfyfield/h3_lora",
      "format": "mp4",
      "codec": "h264",
      "format.codec": "h264"
    }
  },
  "16": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "{{image}}"
    },
    "_meta": {
      "title": "Start frame"
    }
  },
  "17": {
    "class_type": "GetImageSize",
    "inputs": {
      "image": [
        "16",
        0
      ]
    }
  },
  "18": {
    "class_type": "ComfyMathExpression",
    "inputs": {
      "expression": "32 * round(a * min(768 / min(a, b), 1344 / max(a, b)) / 32)",
      "values.a": [
        "17",
        0
      ],
      "values.b": [
        "17",
        1
      ]
    },
    "_meta": {
      "title": "Width: the photo's shape on H3's 768 px short edge, 1344 px cap"
    }
  },
  "19": {
    "class_type": "ComfyMathExpression",
    "inputs": {
      "expression": "32 * round(b * min(768 / min(a, b), 1344 / max(a, b)) / 32)",
      "values.a": [
        "17",
        0
      ],
      "values.b": [
        "17",
        1
      ]
    },
    "_meta": {
      "title": "Height"
    }
  },
  "20": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "{{image2}}"
    },
    "_meta": {
      "title": "End frame (a loop LoRA gets the start photo again)",
      "optional": "image2"
    }
  }
}
