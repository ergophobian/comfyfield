# Optional. You can also paste keys on the Connections page, which saves them to .comfyfield/keys.json.
# ComfyUI runs go to Comfy Cloud at once (needs a paid Comfy plan), or to your Pod while one is ready.
COMFY_API_KEY=
# Development only: send ComfyUI runs to a ComfyUI on this machine instead.
# COMFY_MODE=local
# COMFY_URL=http://127.0.0.1:8188
FAL_KEY=
ELEVENLABS_API_KEY=
# RunPod key for Pods, and the most Pods may spend in one day (dollars, default 20).
RUNPOD_API_KEY=
RUNPOD_DAILY_CAP=20
# Set to 1 to fake RunPod and the Pod while working on the Pod UI. Nothing is started or charged.
# COMFYFIELD_POD_SANDBOX=1
